{
  "expo": {
    "name": "Taskify",
    "slug": "gestor-tareas-taller",
    "scheme": "gestortareas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8FF",
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "com.instituto.gestortareastaller"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
