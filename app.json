    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5db04394-75c6-497f-9c62-257b4f1febdc"
      }
    }
  }
}
