{
  "name": "gestor-tareas-debugging",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "backend": "..\\fesquivel\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --reload-dir ..\\fesquivel\\fastapi_sqlalchemy_demo --host 0.0.0.0 --port 8000 --app-dir ..\\fesquivel\\fastapi_sqlalchemy_demo",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
